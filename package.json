{
  "name": "lessonloop-validation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:evals": "node scripts/validate-eval-corpus.mjs",
    "probe:copilot": "node --import tsx probes/copilot/host-probe.ts",
    "probe:copilot-hooks": "node --import tsx probes/copilot/host-hook-probe.ts"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
