{
  "name": "lessonloop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/cli/main.js serve",
    "cli": "node dist/cli/main.js",
    "test:postgres": "node scripts/test-postgres.mjs",
    "validate:p0": "node --import tsx scripts/run-p0.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:evals": "node scripts/validate-eval-corpus.mjs",
    "probe:copilot": "node --import tsx probes/copilot/host-probe.ts",
    "probe:copilot-hooks": "node --import tsx probes/copilot/host-hook-probe.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vectorize-io/hindsight-client": "0.9.2",
    "js-tiktoken": "1.0.21",
    "jsonc-parser": "3.3.1",
    "pg": "8.16.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.6",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
