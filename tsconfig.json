{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": ".local-validation/build"
  },
  "include": [
    "src/**/*.ts",
    "evals/**/*.ts",
    "probes/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
